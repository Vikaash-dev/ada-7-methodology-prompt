      "linting": "pass",
      "documentation": "complete"
    },
    "recommendation_quality": {
      "options_presented": "3+",
      "evidence_per_option": "3+ sources",
      "contradictions_addressed": "all",
      "confidence_documented": "always"
    }
  },
  
